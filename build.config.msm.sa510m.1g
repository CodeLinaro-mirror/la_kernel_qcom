################################################################################
## Inheriting configs from ACK
. "${ROOT_DIR}"/msm-kernel/build.config.common
. "${ROOT_DIR}"/msm-kernel/build.config.arm

################################################################################
## Variant setup
MSM_ARCH=sa510m-1g

################################################################################
## Variant setup

HERMETIC_TOOLCHAIN=0
VARIANTS=(perf_defconfig debug_defconfig)
[ -z "${VARIANT}" ] && VARIANT=debug_defconfig

if [ -e "${ROOT_DIR}/msm-kernel" ] && [ "${KERNEL_DIR}" = "common" ] ; then
	KERNEL_DIR="msm-kernel"
fi

ABL_SRC=bootable/bootloader/edk2
BOOT_IMAGE_HEADER_VERSION=2
BASE_ADDRESS=0x80000000
PAGE_SIZE=4096
DTB_IMG_CREATE=1
TARGET_HAS_SEPARATE_RD=1
PREFERRED_USERSPACE=le-32
DO_NOT_STRIP_MODULES=0
[ -z "${DT_OVERLAY_SUPPORT}" ] && DT_OVERLAY_SUPPORT=0

if [ "${KERNEL_CMDLINE_CONSOLE_AUTO}" != "0" ]; then
	KERNEL_CMDLINE+='console=ttyMSM0,115200n8 earlycon=qcom_geni,0x98c000 msm_geni_serial.con_enabled=1 loglevel=8 root=/dev/ram filesystem=ramfs'
fi

## Inheriting MSM configs
. "${KERNEL_DIR}"/build.config.msm.common
. "${KERNEL_DIR}"/build.config.msm.tele
## Inheriting MSM configs
. "${KERNEL_DIR}"/build.config.msm.common

DEFCONFIG="generic_tele_min_defconfig"
function build_defconfig_fragments() {
	if [[ "${VARIANT}" =~ ^(perf_defconfig|debug_defconfig)$ ]]; then
		apply_defconfig_fragment "${KERNEL_DIR}"/arch/"${ARCH}"/configs/vendor/sa510m.config vendor/"${MSM_ARCH}"_defconfig
		apply_defconfig_fragment "${KERNEL_DIR}"/arch/"${ARCH}"/configs/vendor/"${MSM_ARCH}".config vendor/"${MSM_ARCH}"_defconfig
		if [ "${VARIANT}" = perf_defconfig ]; then
			return
		fi
		apply_defconfig_fragment "${KERNEL_DIR}"/arch/"${ARCH}"/configs/vendor/sa510m_debug.config vendor/"${MSM_ARCH}"-debug_defconfig
	else
		echo "Variant '${VARIANT}' unsupported by mdm"
		exit 1
	fi
}
build_defconfig_fragments

