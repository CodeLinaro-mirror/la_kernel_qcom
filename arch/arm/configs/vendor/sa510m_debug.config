# CONFIG_CAN_ISOTP is not set
# CONFIG_CAN_J1939 is not set
# CONFIG_CAN_KVASER_PCIEFD is not set
# CONFIG_CAN_KVASER_USB is not set
# CONFIG_CAN_MCBA_USB is not set
# CONFIG_CAN_M_CAN is not set
CONFIG_CAN_NETLINK=y
# CONFIG_CAN_PEAK_PCIEFD is not set
# CONFIG_CAN_PEAK_USB is not set
CONFIG_CAN_RAW=y
# CONFIG_CAN_SJA1000 is not set
# CONFIG_CAN_SLCAN is not set
# CONFIG_CAN_SOFTING is not set
# CONFIG_CAN_TI_HECC is not set
# CONFIG_CAN_UCAN is not set
# CONFIG_CAN_VCAN is not set
# CONFIG_CAN_VXCAN is not set
CONFIG_CORESIGHT=y
CONFIG_CORESIGHT_CATU=y
CONFIG_CORESIGHT_CPU_DEBUG=y
CONFIG_CORESIGHT_CPU_DEBUG_DEFAULT_ON=y
CONFIG_CORESIGHT_CSR=y
CONFIG_CORESIGHT_CTI=y
CONFIG_CORESIGHT_CTI_INTEGRATION_REGS=y
CONFIG_CORESIGHT_DUMMY=y
CONFIG_CORESIGHT_LINKS_AND_SINKS=y
CONFIG_CORESIGHT_LINK_AND_SINK_TMC=y
# CONFIG_CORESIGHT_QMI is not set
CONFIG_CORESIGHT_REMOTE_ETM=y
CONFIG_CORESIGHT_SINK_ETBV10=y
CONFIG_CORESIGHT_SINK_TPIU=y
CONFIG_CORESIGHT_SOURCE_ETM3X=y
CONFIG_CORESIGHT_STM=y
CONFIG_CORESIGHT_TGU=y
CONFIG_CORESIGHT_TPDA=y
CONFIG_CORESIGHT_TPDM=y
CONFIG_CORESIGHT_TRACE_NOC=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_LOCALVERSION="-debug"
# CONFIG_MINIDUMP_ALL_TASK_INFO is not set
CONFIG_MINIDUMP_MAX_ENTRIES=200
CONFIG_MSM_GPI_DMA_DEBUG=y
# CONFIG_PM_ADVANCED_DEBUG is not set
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# CONFIG_PM_TEST_SUSPEND is not set
# CONFIG_QCOM_DYN_MINIDUMP_STACK is not set
CONFIG_QCOM_IOMMU_DEBUG=y
CONFIG_QCOM_MINIDUMP=y
CONFIG_QCOM_MINIDUMP_FTRACE=y
CONFIG_QCOM_MINIDUMP_PANIC_CPUFREQ_INFO=y
# CONFIG_QCOM_MINIDUMP_PANIC_CPU_CONTEXT is not set
CONFIG_QCOM_MINIDUMP_PANIC_DUMP=y
# CONFIG_QCOM_MINIDUMP_PANIC_MEMORY_INFO is not set
CONFIG_QCOM_MINIDUMP_PSTORE=y
CONFIG_QCOM_SHOW_RESUME_IRQ=y
# CONFIG_QCOM_VA_MINIDUMP is not set
CONFIG_REGMAP_QTI_DEBUGFS=y
CONFIG_REGMAP_QTI_DEBUGFS_ALLOW_WRITE=y
CONFIG_STM=y
CONFIG_STM_DUMMY=y
CONFIG_STM_PROTO_BASIC=y
CONFIG_STM_PROTO_OST=y
CONFIG_STM_PROTO_SYS_T=y
CONFIG_STM_SOURCE_CONSOLE=y
CONFIG_STM_SOURCE_FTRACE=y
