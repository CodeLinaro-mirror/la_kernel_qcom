# CONFIG_CAN_DEBUG_DEVICES is not set
CONFIG_CAN_DEV=y
# CONFIG_CAN_EMS_USB is not set
# CONFIG_CAN_ESD_USB is not set
# CONFIG_CAN_ETAS_ES58X is not set
# CONFIG_CAN_F81604 is not set
# CONFIG_CAN_FLEXCAN is not set
