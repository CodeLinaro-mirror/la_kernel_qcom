CONFIG_CORESIGHT=y
CONFIG_CORESIGHT_CATU=y
CONFIG_CORESIGHT_CPU_DEBUG=y
CONFIG_CORESIGHT_CPU_DEBUG_DEFAULT_ON=y
CONFIG_CORESIGHT_CSR=y
CONFIG_CORESIGHT_CTI=y
CONFIG_CORESIGHT_CTI_INTEGRATION_REGS=y
CONFIG_CORESIGHT_DUMMY=y
CONFIG_CORESIGHT_LINKS_AND_SINKS=y
CONFIG_CORESIGHT_LINK_AND_SINK_TMC=y
# CONFIG_CORESIGHT_QMI is not set
CONFIG_CORESIGHT_REMOTE_ETM=y
CONFIG_CORESIGHT_SINK_ETBV10=y
CONFIG_CORESIGHT_SINK_TPIU=y
CONFIG_CORESIGHT_SOURCE_ETM3X=y
CONFIG_CORESIGHT_STM=y
CONFIG_CORESIGHT_TGU=y
CONFIG_CORESIGHT_TPDA=y
CONFIG_CORESIGHT_TPDM=y
CONFIG_CORESIGHT_TRACE_NOC=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_LOCALVERSION="-debug"
CONFIG_MSM_GPI_DMA_DEBUG=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_QCOM_IOMMU_DEBUG=y
CONFIG_QCOM_SHOW_RESUME_IRQ=y
CONFIG_REGMAP_QTI_DEBUGFS=y
CONFIG_REGMAP_QTI_DEBUGFS_ALLOW_WRITE=y
CONFIG_STM=y
CONFIG_STM_DUMMY=y
CONFIG_STM_PROTO_BASIC=y
CONFIG_STM_PROTO_OST=y
CONFIG_STM_PROTO_SYS_T=y
CONFIG_STM_SOURCE_CONSOLE=y
CONFIG_STM_SOURCE_FTRACE=y
# CONFIG_STM_SOURCE_HEARTBEAT is not set
CONFIG_TRACE_MMIO_ACCESS=y
